{
  "name": "switchless",
  "version": "0.0.1",
  "description": "Replacing hand-written microservice routers with a zero-shot decision model: rules vs LLM vs JEV vs hybrid, benchmarked on Banking77.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx src/server.ts",
    "demo": "tsx scripts/demo.ts",
    "data:download": "tsx scripts/download-banking77.ts",
    "docs:catalog": "tsx scripts/gen-catalog-doc.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "bench": "tsx scripts/bench.ts",
    "report": "tsx scripts/report.ts",
    "loc": "tsx scripts/count-loc.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
